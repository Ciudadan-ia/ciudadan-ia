---
import Base from '../layouts/Base.astro';
import { UI } from '../i18n/ui';

const t = UI.es;
---

<Base lang="es" title={t.offline.title} description={t.offline.body}>
  <div class="wrap measure" style="padding-block: var(--space-6);">
    <h1>{t.offline.title}</h1>
    <p>{t.offline.body}</p>
    <p><a href="/">← {t.allEditions}</a></p>
  </div>
</Base>
