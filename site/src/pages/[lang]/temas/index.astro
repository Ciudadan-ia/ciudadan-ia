---
import TopicsHubPage from '../../../components/TopicsHubPage.astro';
import type { Lang } from '../../../i18n/languages';
import { getActiveLanguages, getIndexAvailability } from '../../../lib/content';

export async function getStaticPaths() {
  const langs = (await getActiveLanguages()).filter((l) => l !== 'es');
  const paths = [];
  for (const lang of langs) {
    const av = await getIndexAvailability(lang);
    if (av.topics.length) paths.push({ params: { lang } });
  }
  return paths;
}
const lang = Astro.params.lang as Lang;
---
<TopicsHubPage lang={lang} />
