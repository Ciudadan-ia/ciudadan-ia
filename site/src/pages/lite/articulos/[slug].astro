---
import { render } from 'astro:content';
import Lite from '../../../layouts/Lite.astro';
import { allArticles, articleSlug, isPublished, resolveArticleForLang } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = await allArticles();
  const slugs = [...new Set(entries.filter((e) => e.data.lang === 'es' && isPublished(e)).map(articleSlug))];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const resolved = await resolveArticleForLang(slug!, 'es');
if (resolved.mode !== 'mono') throw new Error(`Artículo es no encontrado: ${slug}`);
const entry = resolved.entry;
const { Content } = await render(entry);
---

<Lite lang="es" title={entry.data.title} description={entry.data.summary}>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="meta">
      Escribió: {entry.data.author} · {entry.data.publishDate.toISOString().slice(0, 10)}
    </p>
    <p><strong>{entry.data.summary}</strong></p>
    <Content />
    <p><a href={`/articulos/${slug}/`}>Versión completa (con audio) →</a></p>
  </article>
</Lite>
