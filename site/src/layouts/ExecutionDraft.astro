---
import fullCss from '../styles/execution-draft.css?raw';
import liteCss from '../styles/execution-lite.css?raw';
interface Props { title: string; }
const { title } = Astro.props;
const lite = Astro.url.pathname.startsWith('/lite/');
const prefix = lite ? '/lite' : '';
const fullPath = Astro.url.pathname.replace(/^\/lite\//, '/');
const switchPath = lite ? fullPath : `/lite${fullPath}`;
const links = [['portada', 'Portada propuesta'], ['historias', 'Historias'], ['v1', 'Inicio V1'], ['aprender', 'Aprender'], ['faq', 'Preguntas'],
  ['noticias', 'Agenda'], ['biblioteca', 'Biblioteca'], ['editorial-demo', 'Taller editorial']];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · CiudadanIA V1{lite ? ' · lite' : ''}</title>
    <style is:inline set:html={lite ? liteCss : fullCss} />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header>
      <div class="shell">
        <div class="mast">
          <a class="logo" href={lite ? '/lite/' : '/'}>ciudadan<span>IA</span></a>
          <span class="edition">Módulos V1 · borrador de trabajo{lite ? ' · lectura ligera' : ''}</span>
        </div>
        <nav aria-label="Módulos V1">
          {links.map(([slug, label]) => <a href={`${prefix}/${slug}/`}>{label}</a>)}
        </nav>
        <p class="switch-view"><a href={switchPath}>{lite ? 'Versión completa' : 'Versión ligera de lectura'}</a></p>
      </div>
    </header>
    <main class="shell" id="main">
      <p class="notice">Propuesta en revisión. Contenido nuevo en español pendiente de traducción y validación maya/náhuatl. No sustituye las ediciones existentes.</p>
      <div class="page-title"><h1>{title}</h1></div>
      <slot />
      <a href={`${prefix}/v1/`} class="return">← Volver a los módulos V1</a>
    </main>
    <footer class="shell">
      <p>Materiales asistidos por IA. Pendientes de revisión pedagógica, científica y comunitaria.</p>
      <nav aria-label="Gobernanza y transparencia">
        <a href="/manifiesto/">Manifiesto</a>
        <a href="/gobernanza-de-datos/">Gobernanza de datos</a>
        <a href="/politica-de-ia/">Política de IA</a>
        <a href="/transparencia/">Transparencia</a>
      </nav>
    </footer>
  </body>
</html>
