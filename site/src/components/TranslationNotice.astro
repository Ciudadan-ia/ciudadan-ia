---
/** Aviso de traducción pendiente de validación (constitución V / FR-008). */
import { langPath, type Lang } from '../i18n/languages';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
---

<p class="translation-notice" role="note">
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
    <path d="M10 2 1 18h18L10 2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M10 8v4.5" stroke="currentColor" stroke-width="1.6" />
    <circle cx="10" cy="15" r="0.9" fill="currentColor" />
  </svg>
  <span>
    {t.translationNotice}
    <a href={`${langPath(lang)}/contribuye/`}>{UI[lang].contributeShort} →</a>
  </span>
</p>

<style>
  .translation-notice {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    background: var(--maiz-soft);
    border: 1px solid var(--maiz);
    border-radius: var(--radius);
    padding: var(--space-3);
    font-family: var(--font-ui);
    font-size: 0.92rem;
  }
  svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--maiz);
  }
</style>
