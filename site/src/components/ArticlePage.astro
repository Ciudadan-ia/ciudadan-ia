---
/**
 * Página de artículo (FR-006..009, FR-014..016): respuesta corta primero,
 * capa profunda con tiempo de lectura, créditos, audio o CTA de voz, y vista
 * bilingüe cuando la traducción está pendiente de validación.
 */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { langPath, type Lang } from '../i18n/languages';
import { UI } from '../i18n/ui';
import {
  articleSlug,
  getArticleVersions,
  getRelated,
  getSeriesNav,
  getSources,
  readingTimeMin,
  type Article,
  type ResolvedArticle,
} from '../lib/content';
import { FORMAT_LABELS } from '../i18n/taxonomy';
import Credits from './Credits.astro';
import AiAssistedBadge from './AiAssistedBadge.astro';
import Sources from './Sources.astro';
import RelatedQuestions from './RelatedQuestions.astro';
import SeriesNav from './SeriesNav.astro';
import Corrections from './Corrections.astro';
import TranslationNotice from './TranslationNotice.astro';
import AudioPlayer from './AudioPlayer.astro';
import PrestanosTuVoz from './PrestanosTuVoz.astro';
import BilingualView from './BilingualView.astro';
import TopicArt from './TopicArt.astro';

interface Props {
  resolved: Exclude<ResolvedArticle, { mode: 'missing' }>;
  lang: Lang;
}
const { resolved, lang } = Astro.props;
const t = UI[lang];
const entry = resolved.entry;
const slug = articleSlug(entry);

const versions = await getArticleVersions(slug);
const alternates = Object.fromEntries(
  [...versions.keys()].map((l) => [l, `${langPath(l)}/articulos/${slug}/`]),
);

const isBilingual = resolved.mode === 'bilingual';
const Content = !isBilingual ? (await render(entry)).Content : null;
const liteHref = `/lite${langPath(lang)}/articulos/${slug}/`;

const sources = await getSources(slug);
const related = await getRelated(entry, lang);
const seriesNav = await getSeriesNav(entry, lang);
const pendingReview = resolved.mode === 'mono' && resolved.pendingValidation;
const formatLabel = FORMAT_LABELS[entry.data.format][lang];
---

<Base lang={lang} title={entry.data.title} description={entry.data.summary} alternates={alternates}>
  <article class="wrap article" data-pagefind-body>
    <header class="article-header measure">
      <p class="eyebrow">{formatLabel} · {t.topics[entry.data.topic]}</p>
      <h1>{entry.data.title}</h1>
      <Credits article={entry} lang={lang} />
      <AiAssistedBadge article={entry} lang={lang} />
    </header>

    {isBilingual && <div class="measure notice-slot"><TranslationNotice lang={lang} /></div>}
    {pendingReview && (
      <p class="measure pending-review" role="note">{t.pendingTranslationReview}</p>
    )}

    <section class="short-answer measure" aria-labelledby="short-answer-label">
      <p class="eyebrow" id="short-answer-label">{t.readShort}</p>
      <p class="short-answer-text">{entry.data.summary}</p>
    </section>

    {entry.data.audio ? (
      <div class="measure">
        <AudioPlayer
          src={entry.data.audio.src}
          durationSec={entry.data.audio.durationSec}
          lang={lang}
          narrator={entry.data.narrator}
          transcript={entry.data.summary}
        />
      </div>
    ) : (
      <div class="measure"><PrestanosTuVoz lang={lang} /></div>
    )}

    <div class="deep-divider measure">
      <p class="eyebrow">{t.readDeep} · <span class="num">{t.readingTime(readingTimeMin(resolved.mode === 'bilingual' ? resolved.original : entry))}</span></p>
    </div>

    {isBilingual && resolved.mode === 'bilingual' ? (
      <BilingualView translation={resolved.entry} original={resolved.original} lang={lang} />
    ) : (
      <div class="prose measure">
        {Content && <Content />}
      </div>
    )}

    <div class="measure">
      <RelatedQuestions sameLang={related.sameLang} fallbackEs={related.fallbackEs} lang={lang} />
      {seriesNav && <SeriesNav nav={seriesNav} lang={lang} />}
      <Corrections article={entry} lang={lang} />
      <Sources sources={sources} lang={lang} />
    </div>

    <footer class="article-footer measure">
      <p><a href={liteHref}>{t.footer.liteVersion}</a></p>
    </footer>
  </article>
</Base>

<style>
  .article {
    padding-block: var(--space-5);
  }
  .article-header h1 {
    margin-block: var(--space-2) var(--space-3);
  }
  .notice-slot {
    margin-top: var(--space-3);
  }
  .pending-review {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--maiz-soft);
    border-left: 3px solid var(--maiz);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }
  .short-answer {
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border-left: 4px solid var(--anil);
    border-radius: var(--radius);
  }
  .short-answer-text {
    font-size: 1.15rem;
    margin: 0;
  }
  .deep-divider {
    margin-block: var(--space-4) var(--space-3);
    border-top: 1px solid var(--line);
    padding-top: var(--space-3);
  }
  .prose :global(h2) {
    margin-top: var(--space-4);
  }
  .prose :global(p) {
    max-width: var(--measure);
  }
  .article-footer {
    margin-top: var(--space-5);
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }
</style>
