---
/** Crédito nominal (constitución I): autor, traductor, narrador y validador con nombre. */
import type { Lang } from '../i18n/languages';
import { UI } from '../i18n/ui';
import type { Article } from '../lib/content';

interface Props {
  article: Article;
  lang: Lang;
}
const { article, lang } = Astro.props;
const t = UI[lang];
const d = article.data;
const rows = [
  { label: t.credits.author, name: d.author },
  { label: t.credits.translator, name: d.translator },
  { label: t.credits.narrator, name: d.narrator },
  { label: t.credits.validator, name: d.validator },
].filter((r) => r.name);
---

<dl class="credits">
  {rows.map((r) => (
    <div class="credit-row">
      <dt>{r.label}</dt>
      <dd>{r.name}</dd>
    </div>
  ))}
</dl>

<style>
  .credits {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }
  .credit-row {
    display: flex;
    gap: var(--space-1);
  }
  dt {
    color: var(--ink-soft);
  }
  dt::after {
    content: ':';
  }
  dd {
    margin: 0;
    font-weight: 500;
  }
</style>
